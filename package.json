{
  "name": "convert-vscode-extension",
  "displayName": "Convert VSCode Extension",
  "description": "Work with Convert experiments from VS Code with code upload, image upload, experiment creation, local server configs, and MCP tools",
  "version": "0.0.8",
  "publisher": "ShreyashSingh101",
  "engines": {
    "vscode": "^1.115.0"
  },
  "icon": "resources/icon.png",
  "categories": ["Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/shreyashsingh-101/convert-vscode-extension"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "convert-panel",
          "title": "Convert VSCode Extension",
          "icon": "/resources/icon.svg"
        }
      ]
    },
    "views": {
      "convert-panel": [
        {
          "id": "convertDropZone",
          "name": "Files Drop Zone",
          "type": "tree",
          "icon": "/resources/icon.svg"
        },
        {
          "id": "convertSidebar",
          "name": "CVE",
          "type": "webview",
          "icon": "/resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "convert.openCreateExperiment",
        "title": "Convert: Create Experiment"
      },
      {
        "command": "convert.restartMcpServer",
        "title": "Convert: Restart MCP Server"
      },
      {
        "command": "convert.showMcpLogs",
        "title": "Convert: Show MCP Logs"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
